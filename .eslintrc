{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "airbnb-base",
    "airbnb-typescript/base",
    "prettier",
    "plugin:prettier/recommended"
  ],
  "ignorePatterns": [
    "tsup.config.ts"
  ],
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module",
    "project": "./tsconfig.eslint.json"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "class-methods-use-this": 0,
    "import/prefer-default-export": 0,
    "@typescript-eslint/no-redeclare": 0,
    "@typescript-eslint/naming-convention": 0,
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-use-before-define": [
      "error",
      "nofunc"
    ],
    "func-names": 0,
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "ignorePackages",
        "mjs": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "excludedFiles": ["src/ledger/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "starknet",
                "message": "Inside src, import from a relative path. Only src/ledger may import the package by its name: anywhere else, the built dist/index.* would load itself."
              }
            ]
          }
        ]
      }
    }
  ]
}
